# ─── Source PostgreSQL ────────────────────────────────────────────────────────
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5433
SOURCE_DB_NAME=source_db
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=sourcepass

# ─── Target PostgreSQL (DigitalOcean Managed PostgreSQL) ──────────────────────
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=target_db
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=targetpass

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONNECT_URL=http://localhost:8083

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── FastAPI ──────────────────────────────────────────────────────────────────
FASTAPI_URL=http://localhost:8000

# ─── Benchmark Configuration ─────────────────────────────────────────────────
# Comma-separated list of record volumes to benchmark
BENCHMARK_DATA_VOLUMES=1000,5000,10000,50000,100000,500000

# Number of repetitions per volume (for statistical significance)
BENCHMARK_REPETITIONS=10
